# ==============================================================================
# FinSight AI — Git Ignore Rules (Python FastAPI + Next.js + Docker + Data)
# ==============================================================================

# --- Environment Variables & Secrets ---
.env
.env.*
!.env.example
*.pem
*.key

# --- Python / Backend ---
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual Environments (uv / venv / virtualenv / conda)
.venv/
venv/
ENV/
env/

# Testing & Quality Tools (pytest, mypy, ruff, coverage)
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
.tox/
.nox/

# --- Next.js / Frontend (Node.js & TypeScript) ---
node_modules/
.next/
out/
dist/
.vercel/
.turbo/
*.tsbuildinfo
next-env.d.ts
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# --- Databases, Docker & Local Storage ---
*.db
*.sqlite
*.sqlite3
postgres_data/
qdrant_data/
redis_data/

# Data Artifacts (Keep directory structure with .gitkeep if needed, ignore heavy generated files)
data/raw_pdfs/*.pdf
data/processed_md/*.md
data/processed_md/*.json
!data/eval_datasets/*.json
!data/eval_datasets/*.csv

# --- IDEs, Editors & OS ---
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
Desktop.ini

# --- Logs & Scratch ---
*.log
logs/
tmp/
temp/
scratch/

