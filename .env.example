# ==============================================================================
# FinSight AI — Environment Configuration Template (.env.example)
# Copy file này thành `.env` và điền các thông tin cấu hình thực tế.
# ==============================================================================

# --- 1. Application Settings ---
APP_NAME="FinSight AI"
APP_ENV=development
APP_DEBUG=true
API_V1_PREFIX=/api/v1
SECRET_KEY=change-me-in-production-use-a-long-random-string
CORS_ORIGINS=["http://localhost:3000"]

# --- 2. PostgreSQL 16 (Relational DB, RBAC & Structured Financial Metrics) ---
POSTGRES_USER=finsight
POSTGRES_PASSWORD=finsight_secret
POSTGRES_DB=finsight_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://finsight:finsight_secret@localhost:5432/finsight_db

# --- 3. Qdrant Vector Database (Hybrid Search: Dense + Sparse BM25) ---
QDRANT_HOST=localhost
QDRANT_HTTP_PORT=6333
QDRANT_GRPC_PORT=6334
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION_NAME=finsight_child_chunks

# --- 4. Redis (Semantic Cache & Background Task Queue) ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0
SEMANTIC_CACHE_TTL_SECONDS=3600

# --- 5. LLM & Embedding Providers (Pluggable Adapter Layer) ---
# Provider options: gemini | openai | ollama
LLM_PROVIDER=gemini
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_FAST_MODEL=gemini-3.8-flash
GEMINI_REASONING_MODEL=gemini-4-argon
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIMENSION=768

# Optional fallback / alternative providers
OPENAI_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434

# --- 6. Retrieval & Agentic Workflow Configuration ---
HYBRID_SEARCH_TOP_K=20
RERANK_TOP_K=5
RERANKER_PROVIDER=auto
RERANKER_MODEL=gemini-3.5-flash-lite
CROSS_ENCODER_MODEL_NAME=BAAI/bge-reranker-base
MAX_AGENT_RETRIES=2
PARENT_CHUNK_SIZE=1200
CHILD_CHUNK_SIZE=300

# --- 7. Storage Paths ---
RAW_PDF_DIR=./data/raw_pdfs
PROCESSED_MD_DIR=./data/processed_md
EVAL_DATASET_DIR=./data/eval_datasets

# --- 8. Observability (Optional - Langfuse) ---
LANGFUSE_ENABLED=false
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# --- 9. Frontend (Next.js) ---
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1

